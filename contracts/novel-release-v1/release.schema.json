{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Novel Release Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "title", "status", "chapters"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "novel" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "language": { "type": "string", "minLength": 1 },
    "status": { "enum": ["ongoing", "completed"] },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "file"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "pattern": "^chapters/[a-z0-9][a-z0-9._/-]*\\.txt$" },
          "illustrations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "alt", "afterParagraph"],
              "properties": {
                "file": { "type": "string", "pattern": "^images/[a-z0-9][a-z0-9._/-]*\\.(png|jpg|jpeg|webp)$" },
                "alt": { "type": "string", "minLength": 1 },
                "afterParagraph": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
