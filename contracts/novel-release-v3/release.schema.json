{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Novel Release v3 — producer-side contract",
  "description": "For producer export tools. The website does not execute this schema or validate naming, duplicates, ordering or content.",
  "type": "object",
  "required": ["schemaVersion", "kind", "id", "icon", "readme", "volumes"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "kind": { "const": "novel" },
    "id": { "$ref": "#/$defs/segment" },
    "icon": { "type": "string", "minLength": 1 },
    "status": { "type": "string" },
    "readme": { "$ref": "#/$defs/document" },
    "volumes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/volume" } }
  },
  "$defs": {
    "segment": { "type": "string", "minLength": 1, "description": "Producer-owned single URL path segment. No inferred numbering. Uniqueness belongs to the enclosing scope and is the producer's responsibility." },
    "document": {
      "type": "object", "required": ["file"],
      "properties": { "file": { "type": "string", "pattern": "\\.md$", "description": "Package-relative UTF-8 Markdown. The first H1 supplies the visible title." } }
    },
    "chapter": {
      "allOf": [{ "$ref": "#/$defs/document" }],
      "type": "object", "required": ["id"],
      "properties": { "id": { "$ref": "#/$defs/segment" } }
    },
    "volume": {
      "type": "object", "required": ["id", "readme", "chapters"],
      "properties": {
        "id": { "$ref": "#/$defs/segment" },
        "readme": { "$ref": "#/$defs/document" },
        "chapters": { "type": "array", "items": { "$ref": "#/$defs/chapter" } }
      }
    }
  }
}
