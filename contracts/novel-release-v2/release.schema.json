{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Novel Release Contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "title", "status", "icon", "readme", "volumes"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "kind": { "const": "novel" },
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "language": { "type": "string", "minLength": 1 },
    "status": { "enum": ["ongoing", "completed"] },
    "icon": { "type": "string", "pattern": "^images/[a-z0-9][a-z0-9._/-]*\\.png$" },
    "readme": { "$ref": "#/$defs/document" },
    "volumes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "readme", "chapters"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "title": { "type": "string", "minLength": 1 },
          "readme": { "$ref": "#/$defs/document" },
          "chapters": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "title", "file"],
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "title": { "type": "string", "minLength": 1 },
                "file": { "$ref": "#/$defs/markdown" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "markdown": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*\\.md$" },
    "document": {
      "type": "object", "additionalProperties": false, "required": ["file"],
      "properties": { "file": { "$ref": "#/$defs/markdown" } }
    }
  }
}
